#        ssl_session_cache shared:SSL:1m;
#        ssl_session_timeout  10m;
#        ssl_ciphers PROFILE=SYSTEM;
#        ssl_prefer_server_ciphers on;
#
#        # Load configuration files for the default server block.
#        include /etc/nginx/default.d/*.conf;
#    }
}

stream {
  log_format upstream_proxy '$remote_addr [$time_local] '
                 '$protocol $status $bytes_sent $bytes_received '
                 '$session_time "$upstream_addr" '
                 '"$upstream_bytes_sent" "$upstream_bytes_received" "$upstream_connect_time"';
  upstream stream_backend {
    server openldap:389;
  }
  server {
    # server_name auth-1.ibpm.local auth-1.ibpm.pro auth-1.ibpm.pl;
    listen 0.0.0.0:636 ssl;
    listen [::]:636 ssl; 
    listen 0.0.0.0:9636 ssl;
    listen [::]:9636 ssl;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1440m;
    # TLSv1.3 dosn't work with Java clients
    # ssl_protocols TLSv1.2 TLSv1.3;
    ssl_protocols TLSv1.2;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    
    ssl_certificate     /usr/share/nginx/certs/server-cert-chain.crt;
    ssl_certificate_key /usr/share/nginx/certs/server-cert.key;

    error_log  /var/log/nginx/openldaps.error.log debug;
    access_log /var/log/nginx/openldaps.access.log upstream_proxy;

    tcp_nodelay on; 
    proxy_pass stream_backend;
  }
}
