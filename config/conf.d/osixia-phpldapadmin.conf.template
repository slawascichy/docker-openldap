########################################
# Konfiguracja dostępu SSL do aplikacji osixia-phpldapadmin 
########################################
upstream osixia-phpldapadmin {
    server 127.0.0.1:6080;
}

server {
    listen       0.0.0.0:6443 ssl;
    listen       [::]:6443 ssl;
    http2        on;
    server_name  authadmin.ibpm.local authadmin.ibpm.pro authadmin.ibpm.pl;

    ssl_session_cache shared:OSIXIASSL:10m;
    ssl_session_timeout 1440m;
    ssl_protocols TLSv1.2 TLSv1.3;
    # ssl_protocols TLSv1.2;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    ssl_certificate          /opt/nginx/data/certs/server-cert-chain.crt;
    ssl_certificate_key      /opt/nginx/data/certs/server-cert.key;
    ssl_trusted_certificate  /opt/nginx/data/certs/scisoftware_intermediate_ca_chain.crt;

    error_log  /var/log/nginx/osixia-phpldapadmin.error.log notice;
    access_log /var/log/nginx/osixia-phpldapadmin.access.log main;
    
    root /opt/nginx/data/html;
    
    error_page 401 /401.html;
    location = /401.html {
    }
    error_page 403 /403.html;
    location = /403.html {
    }
    error_page 404 /404.html;
    location = /404.html {
    }
    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
    }
    location = /robots.txt {
    }
    location = /ads.txt {
    }
    location /files {
    }
    location /dtd {
    }

    location / {
      
      # Standardowe nagłówki proxy
      proxy_set_header Host $host;
      proxy_set_header X-Real-IP $remote_addr;
      proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
      proxy_set_header X-Forwarded-Proto $scheme;

      # Bufory pod duże tokeny IBM (LTPA/SAML) i ciężkie strony
      proxy_buffer_size 128k;
      proxy_buffers 4 256k;
      proxy_busy_buffers_size 256k;

      # Timeouty dla długo trwających procesów
      proxy_read_timeout 900s;
      proxy_send_timeout 900s;

      proxy_pass http://osixia-phpldapadmin;
    }
    
}